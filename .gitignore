# ofxAruco .gitignore
# Keep: addon source (src/, libs/), addon_config.mk, README, and for each
# example/test only src/, addons.make and bin/data resources.
# Projects are regenerated with the openFrameworks projectGenerator.

# --- OS / editor junk ---
.DS_Store
*.DS_*
._*
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# --- IDE project files (projectGenerator output) ---
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcconfig
openFrameworks-Info.plist
*.entitlements
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/
*.cbp
*.layout
*.depend
*.creator*
*.qbs
*.qbs.user
CMakeLists.txt.user
icon.rc
*.ico

# --- Make files generated per project ---
# (addon_config.mk at the root is kept; addons.make in examples is kept)
**/Makefile
**/config.make

# --- Build products ---
**/obj/
**/build/
**/DerivedData/
**/bin/*
!**/bin/data/
**/bin/libs/
**/bin/*.app
**/bin/*.exe
**/bin/*.dll
**/bin/*.pdb
**/bin/*.exp
**/bin/*.lib
**/bin/*.ilk
**/bin/*.log
*.o
*.a
*.so
*.dylib

# --- Files written by the examples / tests at runtime ---
**/bin/data/settings.json
**/bin/data/multicam_calibration.json
**/bin/data/cameras.json
example-print-boards/bin/data/*
!example-print-boards/bin/data/.gitkeep
tests/*/bin/data/*
!tests/*/bin/data/.gitkeep
